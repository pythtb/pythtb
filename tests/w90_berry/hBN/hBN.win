! Monolayer hBN: 4 isolated valence bands -> 4 MLWFs.
num_wann  = 4
num_bands = 4
exclude_bands = 5-8

! ---- outputs needed by the PythTB W90 reader ----
write_hr   = true
write_xyz  = true
write_tb   = true          ! <-- off-diagonal position matrix  <0n|r|Rm>
translate_home_cell = false

num_iter          = 400
num_print_cycles  = 40
conv_tol          = 1.0e-10
conv_window       = 5

begin atoms_frac
 B  0.0000000000 0.0000000000 0.5000000000
 N  0.3333333333 0.6666666667 0.5000000000
end atoms_frac

begin projections
N : sp2
N : pz
end projections

begin unit_cell_cart
Ang
 2.5040000000 0.0000000000 0.0000000000
 -1.2520000000 2.1685276111 0.0000000000
 0.0000000000 0.0000000000 10.0000000000
end unit_cell_cart

mp_grid = 6 6 1

begin kpoints
 0.0000000000 0.0000000000 0.0000000000
 0.0000000000 0.1666666667 0.0000000000
 0.0000000000 0.3333333333 0.0000000000
 0.0000000000 0.5000000000 0.0000000000
 0.0000000000 0.6666666667 0.0000000000
 0.0000000000 0.8333333333 0.0000000000
 0.1666666667 0.0000000000 0.0000000000
 0.1666666667 0.1666666667 0.0000000000
 0.1666666667 0.3333333333 0.0000000000
 0.1666666667 0.5000000000 0.0000000000
 0.1666666667 0.6666666667 0.0000000000
 0.1666666667 0.8333333333 0.0000000000
 0.3333333333 0.0000000000 0.0000000000
 0.3333333333 0.1666666667 0.0000000000
 0.3333333333 0.3333333333 0.0000000000
 0.3333333333 0.5000000000 0.0000000000
 0.3333333333 0.6666666667 0.0000000000
 0.3333333333 0.8333333333 0.0000000000
 0.5000000000 0.0000000000 0.0000000000
 0.5000000000 0.1666666667 0.0000000000
 0.5000000000 0.3333333333 0.0000000000
 0.5000000000 0.5000000000 0.0000000000
 0.5000000000 0.6666666667 0.0000000000
 0.5000000000 0.8333333333 0.0000000000
 0.6666666667 0.0000000000 0.0000000000
 0.6666666667 0.1666666667 0.0000000000
 0.6666666667 0.3333333333 0.0000000000
 0.6666666667 0.5000000000 0.0000000000
 0.6666666667 0.6666666667 0.0000000000
 0.6666666667 0.8333333333 0.0000000000
 0.8333333333 0.0000000000 0.0000000000
 0.8333333333 0.1666666667 0.0000000000
 0.8333333333 0.3333333333 0.0000000000
 0.8333333333 0.5000000000 0.0000000000
 0.8333333333 0.6666666667 0.0000000000
 0.8333333333 0.8333333333 0.0000000000
end kpoints

begin kpoint_path
G 0.0000000 0.0000000 0.0000000  M 0.5000000 0.0000000 0.0000000
M 0.5000000 0.0000000 0.0000000  K 0.3333333 0.3333333 0.0000000
K 0.3333333 0.3333333 0.0000000  G 0.0000000 0.0000000 0.0000000
end kpoint_path

! ---- postw90 reference: Berry curvature along the k-path ----
! The kpath module (kpath_task = curv) reuses the kpoint_path block above and
! writes the band-summed Berry curvature; it needs the Fermi level to know
! which bands are occupied.
! use_ws_distance=false -> plain  sum_R exp(i k.R)  interpolation, matching the
! PythTB reader exactly (so the two implementations can be compared directly).
use_ws_distance = false
fermi_energy = -0.035000
kpath = true
kpath_task = curv
kpath_num_points = 200
kpath_bands_colour = none
transl_inv = true
